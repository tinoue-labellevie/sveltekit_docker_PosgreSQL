# .env ファイル (my-fullstack-app ディレクトリ直下)
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase
PG_PORT=5432

# NestJS から DB への接続情報 (Docker Compose のサービス名を使用)
DB_TYPE=postgres
DB_HOST=localhost # Docker Compose で定義するサービス名
DB_PORT=5432
DB_USERNAME=myuser
DB_PASSWORD=mypassword
DB_DATABASE=mydatabase

# NestJS API の URL (SvelteKit からアクセス用)
PUBLIC_BACKEND_URL=http://localhost:3000 # NestJS が起動するホストとポート